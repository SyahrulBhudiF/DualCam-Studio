# QUIS monorepo env example
# Copy to .env for local development.

# Database
DATABASE_URL=postgresql://user:password@host:5432/database?pgbouncer=true

# Session Configuration
SESSION_COOKIE_NAME=session_token
SESSION_DURATION_DAYS=7

# Security
BCRYPT_SALT_ROUNDS=10

# Upload storage
# Relative path resolved from the process working directory.
UPLOAD_ROOT=video_uploads

# Predictor gRPC
PREDICTOR_HOST=127.0.0.1
PREDICTOR_PORT=50051
PREDICTOR_PROJECT_ROOT=.
PREDICTOR_UPLOAD_ROOT=video_uploads
PREDICTOR_TABR_ROOT=apps/predictor/vendor/tabular-dl-tabr-official
PREDICTOR_EXP_NAME=convat_apex_anxiety_qwalk_q12_q3_q4
PREDICTOR_EVALUATION_SEED=4
PREDICTOR_THRESHOLD=0.235
# How to combine multiple event/video predictions into one quiz-level score: mean, median, or max.
PREDICTOR_AGGREGATION=mean
PREDICTOR_DEVICE=auto

# Google Drive export/upload integration
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
