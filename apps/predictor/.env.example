# QUIS predictor env example
# Copy to .env when running from apps/predictor.

PREDICTOR_HOST=127.0.0.1
PREDICTOR_PORT=50051
PREDICTOR_PROJECT_ROOT=../..
PREDICTOR_UPLOAD_ROOT=../../video_uploads
PREDICTOR_TABR_ROOT=vendor/tabular-dl-tabr-official
PREDICTOR_EXP_NAME=convat_apex_anxiety_qwalk_q12_q3_q4
PREDICTOR_EVALUATION_SEED=4
PREDICTOR_THRESHOLD=0.235
# How to combine multiple event/video predictions into one quiz-level score: mean, median, or max.
PREDICTOR_AGGREGATION=mean
PREDICTOR_DEVICE=auto
